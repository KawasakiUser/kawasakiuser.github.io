{
  "name": "kawasakiuser-root-site-foundation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "check": "astro check",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "node --import tsx scripts/validate.ts",
    "scan:build": "node --import tsx scripts/scan-build.ts",
    "build": "astro build && npm run scan:build",
    "validate:negative": "node --import tsx scripts/negative-integration.ts",
    "prebuild": "npm run validate"
  },
  "dependencies": {
    "astro": "5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@types/node": "^24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
