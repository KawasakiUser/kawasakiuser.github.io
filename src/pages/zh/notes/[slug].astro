---
import NotesDetail from '../../../../src/components/notes/NotesDetail.astro';
import { getNotesPaths, loadNotesCandidate } from '../../../../src/lib/science-render/candidate-runtime';
import type { NoteDetail } from '../../../../src/lib/science-render/views';
export const getStaticPaths = () => getNotesPaths('zh');
interface Props { model: NoteDetail }
const { model } = Astro.props;
const { getScienceOptions } = loadNotesCandidate();
const science = model.note ? getScienceOptions(model.note) : undefined;
---
<NotesDetail model={model} science={science} />
