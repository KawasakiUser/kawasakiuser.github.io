---
import SiteShell from './SiteShell.astro';
import A23Cover from './A23Cover.astro';
import { getPublishedForLocale, loadIntegrationSnapshot } from '../../lib/integration';
import { routeFor } from '../../lib/routes';

interface Props { locale: 'en' | 'zh'; }
const { locale } = Astro.props;
const isZh = locale === 'zh';
const snapshot = loadIntegrationSnapshot();
const records = getPublishedForLocale(snapshot, locale);
const projects = records.filter((record) => record.entity === 'Project');
const archive = records.filter((record) => record.entity === 'ArchiveRecord' && record.archiveKind === 'Work');
const notes = records.filter((record) => record.entity === 'Note');
const copy = isZh
  ? {
      projects: '当前项目',
      archive: '近期档案',
      notes: '精选笔记',
      about: '关于',
      emptyArchive: '当前语言暂无已发布的 Work。',
      emptyNotes: '当前语言暂无已发布的笔记。',
      noteLabel: '合成工程样例',
      aboutTitle: '理解，是创造的起点。',
      aboutBody: '我循着问题探索不同领域，寻找彼此相通的基本原理，并尝试将值得深入的想法发展为能够长期推进的项目与系统。',
      aboutCta: '关于我 →'
    }
  : {
      title: 'ShiJie Wang',
      projects: 'Current Projects',
      archive: 'Recent Archive',
      notes: 'Selected Notes',
      about: 'About',
      emptyArchive: 'No published Work is available in this language.',
      emptyNotes: 'No published Notes are available in this language.',
      noteLabel: 'Synthetic engineering fixture',
      aboutTitle: 'Understanding is where creation begins.',
      aboutBody: 'I follow questions across disciplines, looking for the principles that connect them. I seek to turn promising ideas into projects and systems that can develop over time.',
      aboutCta: 'About me →'
    };
---
<SiteShell locale={locale} notesHref={notes.length > 0 ? (isZh ? '/zh/#notes' : '/#notes') : null}>
  <main id="main" tabindex="-1">
    <A23Cover locale={locale} />

    <section id="projects" class="home-section projects-section" aria-labelledby="projects-heading">
      <div class="section-heading"><span class="section-number">02</span><h2 id="projects-heading">{copy.projects}</h2></div>
      <div class="project-list">
        {projects.length ? projects.map((project) => <article class="record-card"><p class="record-kicker">{project.primaryType ?? 'Project'}</p><h3>{project.title}</h3><p>{project.summary}</p>{routeFor(project) && <a class="text-link" href={routeFor(project)!}>{isZh ? '查看项目 →' : 'View project →'}</a>}</article>) : <p class="empty-state">{isZh ? '当前语言暂无已发布的项目。' : 'No published Projects are available in this language.'}</p>}
      </div>
    </section>

    <section id="archive" class="home-section archive-section" aria-labelledby="archive-heading">
      <div class="section-heading"><span class="section-number">03</span><h2 id="archive-heading">{copy.archive}</h2></div>
      <div class="archive-list">
        {archive.length ? archive.map((item) => <article class="record-card"><p class="record-kicker">{item.date}</p><h3>{item.title}</h3><p>{item.summary}</p>{routeFor(item) && <a class="text-link" href={routeFor(item)!}>{isZh ? '查看档案 →' : 'View archive →'}</a>}</article>) : <p class="empty-state">{copy.emptyArchive}</p>}
      </div>
    </section>

    {notes.length > 0 && <section id="notes" class="home-section notes-section" aria-labelledby="notes-heading">
      <div class="section-heading"><span class="section-number">04</span><h2 id="notes-heading">{copy.notes}</h2></div>
      <div class="notes-list">
        {notes.slice(0, 3).map((note) => <article class="record-card"><p class="record-kicker">{note.category ?? copy.noteLabel}</p><h3>{note.title}</h3><p>{note.summary ?? note.body}</p>{routeFor(note) && <a class="text-link" href={routeFor(note)!}>{isZh ? '阅读笔记 →' : 'Read note →'}</a>}</article>)}
      </div>
    </section>}

    <section id="about" class="home-section about-section" aria-labelledby="about-heading">
      <div class="section-heading"><span class="section-number">05</span><h2 id="about-heading">{copy.about}</h2></div>
      <div class="about-grid">
        <h3>{copy.aboutTitle}</h3>
        <div><p>{copy.aboutBody}</p><a class="about-cta" href={isZh ? '/zh/about/' : '/about/'}>{copy.aboutCta}</a></div>
      </div>
    </section>
  </main>
</SiteShell>

<style>
  main { display: block; }
  .home-section { padding: clamp(4.5rem, 10vw, 10rem) clamp(1.2rem, 8vw, 9rem); }
  .section-number { display: inline-block; color: #8e303b; font-size: .9rem; letter-spacing: .08em; }
  .eyebrow, .record-kicker { margin: 0 0 1.25rem; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 11ch; margin-bottom: 1.25rem; font-size: clamp(3.8rem, 10vw, 9rem); font-weight: 400; line-height: .93; letter-spacing: -.04em; }
  h2 { margin: .4rem 0 0; font-size: clamp(2rem, 4vw, 4rem); font-weight: 400; letter-spacing: -.03em; }
  h3 { margin-bottom: .7rem; font-size: clamp(1.35rem, 2.3vw, 2.1rem); font-weight: 400; }
  p { line-height: 1.6; }
  .section-heading { display: flex; align-items: baseline; gap: 1rem; margin-bottom: 3rem; }
  .projects-section { background: #eadac2; }
  .archive-section { background: #f4efe6; }
  .notes-section { background: #182a3d; color: #fafaf7; }
  .notes-section .section-number { color: #fafaf7; }
  .about-section { background: #f7f4ed; }
  .project-list, .archive-list, .notes-list { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1.25rem; }
  .record-card { min-height: 12rem; padding: 1.45rem; border: 1px solid currentColor; }
  .record-card p { max-width: 34rem; }
  .record-kicker { opacity: .72; }
  .text-link, .about-cta { display: inline-block; margin-top: 1rem; text-underline-offset: .25em; text-decoration-thickness: 1px; }
  .notes-section .text-link { color: #fafaf7; }
  .notes-section .text-link:focus-visible { outline-color: #fafaf7; }
  @media (forced-colors: active) { .notes-section .text-link:focus-visible { outline-color: Highlight; } }
  .about-cta { color: #8e303b; }
  .empty-state { margin: 0; }
  .about-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(2rem, 8vw, 8rem); align-items: start; }
  .about-grid h3 { max-width: 11ch; font-size: clamp(2.8rem, 6vw, 6.5rem); line-height: .95; }
  .about-grid p { max-width: 35rem; font-size: clamp(1.1rem, 1.6vw, 1.45rem); }
  @media (max-width: 820px) { .about-grid { grid-template-columns: 1fr; gap: 1rem; } }
  @media (max-width: 390px) { .home-section { padding-block: 3.75rem; } .section-heading { gap: .65rem; } }
  @media (forced-colors: active) { .record-card { border: 1px solid CanvasText; } }
</style>
