---
import SiteShell from '../shell/SiteShell.astro';
import type { Locale } from '../../lib/types';
import { notesIndexPath } from '../../lib/science-render/views';

interface Props {
  locale: Locale;
  title: string;
  titleLocale?: Locale;
  description?: string;
  canonical?: string;
  alternates?: { locale: Locale; path: string }[];
}
const { locale, title, titleLocale = locale, description, canonical, alternates = [] } = Astro.props;
const site = Astro.site;
const url = (path: string) => {
  if (!site) throw new Error('NOTES_METADATA: canonical site missing');
  return new URL(path, site).href;
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title lang={titleLocale}>{title} · ShiJie Wang</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="noindex" />
    {canonical && <link rel="canonical" href={url(canonical)} />}
    {alternates.map(({ locale: language, path }) => <link rel="alternate" hreflang={language} href={url(path)} />)}
  </head>
  <body>
    <SiteShell locale={locale} notesHref={notesIndexPath(locale)}>
      <slot />
    </SiteShell>
  </body>
</html>
